# Copy to .env and fill in — .env is gitignored and must never be committed.
# scripts/deploy.sh sources it; DABs reads BUNDLE_VAR_* as bundle variables.
BUNDLE_VAR_catalog=your_uc_catalog
BUNDLE_VAR_monitor_admins=you@example.com
BUNDLE_VAR_genie_space_id=unset
BUNDLE_VAR_monitor_url=unset
BUNDLE_VAR_workspaces=[]
BUNDLE_VAR_deployment_mode=standalone
BUNDLE_VAR_hub_catalog=unset
BUNDLE_VAR_workspace_name=
BUNDLE_VAR_external_sp=unset
